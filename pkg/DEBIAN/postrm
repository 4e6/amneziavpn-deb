#!/bin/sh
set -e

if [ "$1" = remove ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper mask AmneziaVPN.service >/dev/null || true
    fi
fi

if [ "$1" = purge ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper purge AmneziaVPN.service >/dev/null || true
        deb-systemd-helper unmask AmneziaVPN.service >/dev/null || true
    fi
    rm -rf /var/log/AmneziaVPN
fi

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

# Per-user settings (~/.config/AmneziaVPN.ORG) are deliberately left alone.
exit 0
