#!/bin/sh
# Launcher for the AmneziaVPN client.
#
# Without a bundled server (a plain repack, no default.conf) it just runs the
# client. Otherwise: the client has no "default server" setting, but it does
# accept `--import <data>` (a vpn:// key or a WireGuard/AmneziaWG .conf body).
# If the bundled server is not yet in the current user's settings, add that
# argument. The client stores servers in plain QSettings, so the
# server's public key shows up verbatim in the file once it has been imported.
#
# `--import` is NOT idempotent (a second run adds a duplicate server), hence
# the grep guard.
#
# It adds `--connect 0` (connect on start) only if the package was built with
# build.sh --autoconnect; the default is off.

# Set at build time (container-build.sh substitutes it: 1 = connect on start).
# Left unsubstituted, as in this source file, it is not 1, so connecting is off.
AUTOCONNECT=@AUTOCONNECT@
APP=/opt/AmneziaVPN/bin/AmneziaVPN
CONF=/usr/share/amneziavpn/default.conf
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/AmneziaVPN.ORG/AmneziaVPN.conf"

# Connect on startup (server index 0) only if built that way, and unless the caller chose otherwise.
want_import=1
want_connect=$AUTOCONNECT
[ -r "$CONF" ] || { want_import=0; want_connect=0; }
for arg in "$@"; do
    case "$arg" in
        --import|--import=*) want_import=0 ;;
        --connect|--connect=*) want_connect=0 ;;
        -h|--help|--help-all|-v|--version) want_import=0; want_connect=0 ;;
    esac
done

if [ "$want_import" = 1 ]; then
    pubkey=$(sed -n 's/^[[:space:]]*PublicKey[[:space:]]*=[[:space:]]*//p' "$CONF" | head -n 1 | tr -d '\r')
    if [ -n "$pubkey" ] && ! grep -qsF -- "$pubkey" "$SETTINGS"; then
        set -- "$@" --import "$(cat "$CONF")"
    fi
fi

if [ "$want_connect" = 1 ]; then
    set -- "$@" --connect 0
fi

exec "$APP" "$@"
