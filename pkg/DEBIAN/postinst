#!/bin/sh
set -e

if [ "$1" = configure ]; then
    mkdir -p /var/log/AmneziaVPN
fi

# Same unit handling debhelper's dh_installsystemd would generate.
if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
    deb-systemd-helper unmask AmneziaVPN.service >/dev/null || true
    if deb-systemd-helper --quiet was-enabled AmneziaVPN.service; then
        deb-systemd-helper enable AmneziaVPN.service >/dev/null || true
    else
        deb-systemd-helper update-state AmneziaVPN.service >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        if [ -n "$2" ]; then
            deb-systemd-invoke restart AmneziaVPN.service >/dev/null || true
        else
            deb-systemd-invoke start AmneziaVPN.service >/dev/null || true
        fi
    fi
fi

exit 0
